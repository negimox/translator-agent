# Jitsi Translator Agent Configuration

# Required: Jitsi server domain
JITSI_DOMAIN=meet.zaryans.net

# Required: Room name to join
ROOM_NAME=test

# Required: Target language code for this agent (e.g., 'en', 'hi')
TARGET_LANGUAGE=hi

# Optional: Agent settings
AGENT_DISPLAY_NAME_PREFIX=translator-

# ============================================================================
# Audio/Worklet settings (Phase 2)
# ============================================================================
WORKLET_HEARTBEAT_INTERVAL_MS=300
HEARTBEAT_TIMEOUT_MS=1500
AUDIOCONTEXT_RESUME_RETRIES=5
AUDIOCONTEXT_RESUME_BACKOFF_MS=500

# ============================================================================
# VAD (Voice Activity Detection) settings (Phase 3)
# ============================================================================
# RMS threshold for voice activity detection (0.01 = -40dB, sensitive to speech)
VAD_RMS_THRESHOLD=0.01
# Number of frames for VAD smoothing (higher = more stable, slower reaction)
VAD_SMOOTHING_FRAMES=3
# Maximum silence duration (ms) to coalesce between utterances
VAD_SILENCE_COALESCE_MS=250

# ============================================================================
# Chunk aggregation settings (Phase 3)
# ============================================================================
# Target chunk duration in milliseconds (default: 900ms)
TARGET_CHUNK_DURATION_MS=900
# Minimum chunk duration - chunks shorter than this are discarded
MIN_CHUNK_DURATION_MS=300
# Maximum chunk duration - force emit if this limit is reached
MAX_CHUNK_DURATION_MS=3000
# Audio sample rate (should match Jitsi's AudioContext)
AUDIO_SAMPLE_RATE=48000

# ============================================================================
# Debug settings (Phase 3)
# ============================================================================
# Enable debug mode to save chunks to disk for validation
DEBUG_MODE=true
# Directory to save debug chunks
DEBUG_OUTPUT_DIR=./debug_chunks
# Maximum number of debug chunks to save (prevents disk fill-up)
MAX_DEBUG_CHUNKS=100

# ============================================================================
# Health check server
# ============================================================================
HEALTH_PORT=8080

# ============================================================================
# Puppeteer settings
# ============================================================================
CHROME_HEADLESS=false
# Set to false in development to see the browser
CHROME_DEVTOOLS=false

# ============================================================================
# Logging
# ============================================================================
# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# ============================================================================
# Mizan API settings (Phase 4)
# ============================================================================
# Mizan Labs API base URL
MIZAN_BASE_URL=https://platform.mizanlabs.com/api/v1

# Mizan API credentials (Basic Auth)
MIZAN_USERNAME=cloudclinic.ai
MIZAN_PASSWORD=

# API request timeout in milliseconds
MIZAN_TIMEOUT_MS=30000

# ============================================================================
# Translation settings (Phase 4)
# ============================================================================
# Translation template name pattern
# Use {target} as placeholder for target language code
# Your template: translator_hi
TRANSLATION_TEMPLATE_PATTERN=translator_{target}

# TTS voice to use (check Mizan API for available voices)
TTS_VOICE=af_heart

# TTS speech speed (0.25 to 4.0)
TTS_SPEED=1.0

# ============================================================================
# Rate limiting (Phase 4)
# ============================================================================
# Token bucket capacity (max tokens in bucket)
TOKEN_BUCKET_CAPACITY=8

# Token bucket refill rate (tokens per second)
TOKEN_BUCKET_REFILL_RATE=8

# ============================================================================
# Circuit breaker (Phase 4)
# ============================================================================
# Error threshold (0-1) to trip circuit
CIRCUIT_BREAKER_ERROR_THRESHOLD=0.1

# Time window for error rate calculation (ms)
CIRCUIT_BREAKER_WINDOW_MS=60000

# Time to wait before half-open (ms)
CIRCUIT_BREAKER_OPEN_TIMEOUT_MS=10000

# ============================================================================
# Queue settings (Phase 4)
# ============================================================================
# Maximum chunks in local queue
MAX_QUEUE_LENGTH=12

# Maximum concurrent Mizan API requests
MAX_IN_FLIGHT=2

# ============================================================================
# Retry settings (Phase 4)
# ============================================================================
# Initial retry delay (ms)
RETRY_INITIAL_DELAY_MS=500

# Maximum retry delay (ms) with exponential backoff
RETRY_MAX_DELAY_MS=8000

# Maximum number of retries per chunk
MAX_RETRIES=3

# ============================================================================
# Adaptive chunking (Phase 4)
# ============================================================================
# Enable adaptive chunk duration based on load
ADAPTIVE_CHUNKING_ENABLED=true

# How often to check and adjust chunk duration (ms)
ADAPTIVE_UPDATE_INTERVAL_MS=1000
BOT_PAGE_PORT=3002