{
  "name": "jitsi-translator-agent",
  "version": "1.0.0",
  "description": "Headless Chromium-based translator agent for Jitsi Meet live audio translation",
  "main": "dist/index.js",
  "scripts": {
    "build": "./node_modules/.bin/tsc",
    "start": "npm run build && node dist/index.js",
    "dev": "./node_modules/.bin/ts-node src/index.ts",
    "lint": "./node_modules/.bin/eslint src/**/*.ts"
  },
  "keywords": [
    "jitsi",
    "translator",
    "webrtc",
    "puppeteer",
    "audio"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "puppeteer": "^24.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.19.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
